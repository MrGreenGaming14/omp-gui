{"$schema":"https://json-schema.org/draft/2020-12/schema","title":"SearchArgs","description":"Search arguments.","type":"object","properties":{"query":{"description":"Text to find, case insensitive.","type":["string","null"]},"mode":{"description":"phrase: the whole query as written. all_words: every word, anywhere.","$ref":"#/$defs/TextMode"},"node":{"description":"Node id from a search hit.","type":["integer","null"],"format":"uint64","minimum":1},"offset":{"description":"next_offset of the previous page.","type":"integer","format":"uint","minimum":0,"default":0},"max_bytes":{"type":["integer","null"],"format":"uint","minimum":1,"maximum":32000},"x":{"description":"Pixels from the left edge","type":"number","format":"float"},"clicks":{"description":"2 for a double click","type":"integer","format":"uint32","minimum":0,"default":1},"modifiers":{"type":"array","items":{"$ref":"#/$defs/ModifierKey"}},"submit":{"type":"boolean","default":false},"network":{"type":["boolean","null"]},"cpus":{"type":["integer","null"],"format":"uint32","minimum":0},"mode2":{"anyOf":[{"$ref":"#/$defs/TextMode"},{"type":"null"}]}},"additionalProperties":false,"required":["x"],"$defs":{"TextMode":{"description":"How a text query matches.","oneOf":[{"description":"The whole query as one substring.","type":"string","const":"phrase"},{"description":"Every whitespace separated word, anywhere.","type":"string","const":"all_words"}]},"ModifierKey":{"type":"string","enum":["shift","ctrl"]}}}