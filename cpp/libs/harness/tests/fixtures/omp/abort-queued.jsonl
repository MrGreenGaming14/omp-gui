# omp 19, `abort_and_restore_queue` while a follow-up waits in omp's queue:
# omp withdraws it, aborts the run and completes both prompts `aborted`.
# (A plain `abort` leaves the follow-up queued and settles neither prompt.)
{"$":"send","id":"p","text":"prompt p"}
{"id":"p","type":"response","command":"prompt","success":true}
{"type":"agent_start"}
{"type":"turn_start"}
{"type":"message_start","message":{"role":"user","content":[{"type":"text","text":"Write the numbers from 1 to 600, one per line, with no other text."}],"attribution":"user"},"messageId":"msg-1"}
{"type":"message_end","message":{"role":"user","content":[{"type":"text","text":"Write the numbers from 1 to 600, one per line, with no other text."}],"attribution":"user"},"messageId":"msg-1"}
{"type":"message_start","message":{"role":"assistant","content":[{"type":"text","text":"1\n2"}],"stopReason":"stop"},"messageId":"msg-2"}
{"type":"message_update","assistantMessageEvent":{"type":"text_start","contentIndex":0,"block":{"type":"text","text":""}},"message":{"role":"assistant"},"messageId":"msg-2"}
{"type":"message_update","assistantMessageEvent":{"type":"text_delta","contentIndex":0,"delta":"1\n2\n3\n4"},"message":{"role":"assistant"},"messageId":"msg-2"}
{"$":"send","id":"p2","text":"prompt p2"}
{"type":"queue_update","steering":[],"followUp":["Now reply with exactly the word: second"],"liveSteered":0}
{"id":"p2","type":"response","command":"prompt","success":true}
{"type":"queue_update","steering":[],"followUp":[],"liveSteered":0}
{"type":"message_end","message":{"role":"assistant","content":[{"type":"text","text":"1\n2\n3\n4"}],"stopReason":"aborted","errorMessage":"Interrupted by user"},"messageId":"msg-2"}
{"type":"turn_end","message":{"role":"assistant","content":[{"type":"text","text":"1\n2\n3\n4"}],"stopReason":"aborted","errorMessage":"Interrupted by user"},"toolResults":[]}
{"type":"agent_end","messages":[],"isTerminal":true,"yielded":true}
{"id":"ab","type":"response","command":"abort_and_restore_queue","success":true,"data":{"steering":[],"followUp":[{"text":"Now reply with exactly the word: second"}]}}
{"type":"prompt_result","id":"p","agentInvoked":true,"status":"aborted","sessionSettled":true}
{"type":"prompt_result","id":"p2","agentInvoked":true,"status":"aborted","sessionSettled":true}
{"type":"session_settled"}
