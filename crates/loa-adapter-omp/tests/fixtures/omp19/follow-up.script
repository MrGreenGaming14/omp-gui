# omp 19, a second prompt sent with `streamingBehavior: "followUp"` while the
# first streams: omp queues it, delivers it as a user message after the first
# reply's turn, and settles both prompts at the run's end (second first).
< prompt p
> {"id":"{{p}}","type":"response","command":"prompt","success":true}
> {"type":"agent_start"}
> {"type":"turn_start"}
> {"type":"message_start","message":{"role":"user","content":[{"type":"text","text":"Write the numbers from 1 to 60, one per line, with no other text."}],"attribution":"user"},"messageId":"msg-1"}
> {"type":"message_end","message":{"role":"user","content":[{"type":"text","text":"Write the numbers from 1 to 60, one per line, with no other text."}],"attribution":"user"},"messageId":"msg-1"}
> {"type":"message_start","message":{"role":"assistant","content":[{"type":"text","text":"1\n2\n3\n4"}],"stopReason":"stop"},"messageId":"msg-2"}
> {"type":"message_update","assistantMessageEvent":{"type":"text_start","contentIndex":0,"block":{"type":"text","text":""}},"message":{"role":"assistant"},"messageId":"msg-2"}
> {"type":"message_update","assistantMessageEvent":{"type":"text_delta","contentIndex":0,"delta":"1\n2\n3\n4"},"message":{"role":"assistant"},"messageId":"msg-2"}
< prompt p2
> {"type":"queue_update","steering":[],"followUp":["Now reply with exactly the word: second"],"liveSteered":0}
> {"id":"{{p2}}","type":"response","command":"prompt","success":true}
> {"type":"message_update","assistantMessageEvent":{"type":"text_delta","contentIndex":0,"delta":"\n5\n6"},"message":{"role":"assistant"},"messageId":"msg-2"}
> {"type":"message_update","assistantMessageEvent":{"type":"text_end","contentIndex":0,"content":"1\n2\n3\n4\n5\n6","block":{"type":"text"}},"message":{"role":"assistant"},"messageId":"msg-2"}
> {"type":"message_end","message":{"role":"assistant","content":[{"type":"text","text":"1\n2\n3\n4\n5\n6"}],"stopReason":"stop"},"messageId":"msg-2"}
> {"type":"turn_end","message":{"role":"assistant","content":[{"type":"text","text":"1\n2\n3\n4\n5\n6"}],"stopReason":"stop"},"toolResults":[]}
> {"type":"queue_update","steering":[],"followUp":[],"liveSteered":0}
> {"type":"turn_start"}
> {"type":"message_start","message":{"role":"user","content":[{"type":"text","text":"Now reply with exactly the word: second"}],"attribution":"user"},"messageId":"msg-3"}
> {"type":"message_end","message":{"role":"user","content":[{"type":"text","text":"Now reply with exactly the word: second"}],"attribution":"user"},"messageId":"msg-3"}
> {"type":"message_start","message":{"role":"assistant","content":[{"type":"text","text":"second"}],"stopReason":"stop"},"messageId":"msg-4"}
> {"type":"message_update","assistantMessageEvent":{"type":"text_start","contentIndex":0,"block":{"type":"text","text":""}},"message":{"role":"assistant"},"messageId":"msg-4"}
> {"type":"message_update","assistantMessageEvent":{"type":"text_delta","contentIndex":0,"delta":"second"},"message":{"role":"assistant"},"messageId":"msg-4"}
> {"type":"message_update","assistantMessageEvent":{"type":"text_end","contentIndex":0,"content":"second","block":{"type":"text"}},"message":{"role":"assistant"},"messageId":"msg-4"}
> {"type":"message_end","message":{"role":"assistant","content":[{"type":"text","text":"second"}],"stopReason":"stop"},"messageId":"msg-4"}
> {"type":"turn_end","message":{"role":"assistant","content":[{"type":"text","text":"second"}],"stopReason":"stop"},"toolResults":[]}
> {"type":"agent_end","messages":[],"isTerminal":true,"yielded":true}
> {"type":"prompt_result","id":"{{p2}}","agentInvoked":true,"status":"completed","sessionSettled":true}
> {"type":"prompt_result","id":"{{p}}","agentInvoked":true,"status":"completed","sessionSettled":true}
> {"type":"session_settled"}
